#!/usr/bin/env python3
"""Resource-only adapter around the exact official RISC Zero Docker image.

No circuit, witness, prover, proof JSON or public input rewriting is performed.
The original r0vm invokes docker through PATH; refuse every unrelated command.
"""
import json
import os
from pathlib import Path
import subprocess
import sys
from resource_group import check_kernel_limits

HERE = Path(__file__).resolve().parent
pins = json.loads((HERE / 'pins.json').read_text())
real = os.environ['ONCM_REAL_DOCKER']
args = sys.argv[1:]
if args == ['--version']:
    os.execv(real, [real, '--version'])
work = Path(os.environ['ONCM_CASE_DIR']).resolve()
expected = ['run', '--rm', '-v', f'{work}:/mnt', pins['docker']['requestedTag']]
if args != expected:
    raise SystemExit('Refusing unexpected Docker command')
case_name = os.environ['ONCM_CONTAINER_NAME']
shared_slice = os.environ['ONCM_CGROUP_SLICE']
from resource_group import slice_name
if shared_slice != slice_name(case_name):
    raise SystemExit('Unexpected shared cgroup parent')
check_kernel_limits(Path('/sys/fs/cgroup') / shared_slice)
cmd = [real, 'run', '--rm', '--pull=never', '--platform=linux/amd64',
       '--cgroup-parent=' + shared_slice,
       '--name', case_name, '--label', 'oncm.ci-run=' + os.environ['ONCM_CI_RUN'],
       '--cidfile', str(work / 'container.cid'), '--network=none',
       '--memory=' + pins['docker']['memory'], '--memory-swap=' + pins['docker']['memorySwap'],
       '--cpus=' + pins['docker']['cpus'], '--pids-limit=' + str(pins['docker']['pidsLimit']),
       '--security-opt=no-new-privileges', '--cap-drop=ALL',
       '--user', f'{os.getuid()}:{os.getgid()}',
       '-e', 'GOMAXPROCS=2', '-e', 'GOMEMLIMIT=8GiB', '-e', 'OMP_NUM_THREADS=2',
       '-v', f'{work}:/mnt', pins['docker']['pinnedImage']]
(work / 'docker-command.json').write_text(json.dumps(cmd, indent=2) + '\n')
os.execv(real, cmd)
