[
  [
    "{toolchain}/bin/lean",
    "-j",
    "1",
    "{work}/Export.lean",
    "-o",
    "{work}/.lake/build/lib/lean/Export.olean",
    "-i",
    "{work}/.lake/build/lib/lean/Export.ilean",
    "-c",
    "{work}/.lake/build/ir/Export.c",
    "--setup",
    "{work}/.lake/build/ir/Export.setup.json",
    "--json"
  ],
  [
    "{toolchain}/bin/clang",
    "-c",
    "-o",
    "{work}/.lake/build/ir/Export.c.o.export",
    "{work}/.lake/build/ir/Export.c",
    "-I",
    "{toolchain}/include",
    "-fstack-clash-protection",
    "-ffp-contract=off",
    "-fdata-sections",
    "-ffunction-sections",
    "-fvisibility=hidden",
    "-Wno-unused-command-line-argument",
    "--sysroot",
    "{toolchain}",
    "-nostdinc",
    "-isystem",
    "{toolchain}/include/clang",
    "-O3",
    "-DNDEBUG",
    "-DLEAN_EXPORTING"
  ],
  [
    "{toolchain}/bin/lean",
    "-j",
    "1",
    "{work}/Main.lean",
    "-o",
    "{work}/.lake/build/lib/lean/Main.olean",
    "-i",
    "{work}/.lake/build/lib/lean/Main.ilean",
    "-c",
    "{work}/.lake/build/ir/Main.c",
    "--setup",
    "{work}/.lake/build/ir/Main.setup.json",
    "--json"
  ],
  [
    "{toolchain}/bin/clang",
    "-c",
    "-o",
    "{work}/.lake/build/ir/Main.c.o.export",
    "{work}/.lake/build/ir/Main.c",
    "-I",
    "{toolchain}/include",
    "-fstack-clash-protection",
    "-ffp-contract=off",
    "-fdata-sections",
    "-ffunction-sections",
    "-fvisibility=hidden",
    "-Wno-unused-command-line-argument",
    "--sysroot",
    "{toolchain}",
    "-nostdinc",
    "-isystem",
    "{toolchain}/include/clang",
    "-O3",
    "-DNDEBUG",
    "-DLEAN_EXPORTING"
  ],
  [
    "{toolchain}/bin/clang",
    "-o",
    "{work}/.lake/build/bin/lean4export",
    "@{work}/.lake/build/bin/lean4export.rsp"
  ]
]
