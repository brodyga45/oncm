{
  "name": "agora-mathematical-markets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "node scripts/compile.mjs && node scripts/compile-social.mjs && vite build",
    "compile": "node scripts/compile.mjs",
    "test": "node --test tests/*.test.mjs",
    "api": "node server/index.mjs",
    "web": "vite --host 127.0.0.1 --port 5171",
    "deploy": "node scripts/deploy.mjs",
    "test:economy": "node --test tests/economy.test.mjs",
    "compile:social": "node scripts/compile-social.mjs",
    "deploy:social": "node scripts/deploy-social.mjs",
    "test:social": "node --test tests/onchain-social.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@gnosis.pm/conditional-tokens-contracts": "1.0.3",
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-v4": "npm:@openzeppelin/contracts@4.9.6",
    "@safe-global/safe-contracts": "1.4.1-2",
    "fastify": "5.2.1",
    "ganache": "7.9.2",
    "p-queue": "8.1.0",
    "solc": "0.8.28",
    "solc-legacy": "npm:solc@0.5.17",
    "viem": "2.31.0",
    "vue": "3.5.16",
    "ajv": "8.20.0",
    "@scure/base": "1.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "6.3.5"
  }
}
