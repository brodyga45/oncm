    "prettier-plugin-svelte": "3.3.3",
    "solady": "0.1.26",
    "solc": "0.8.28",
    "solc17": "npm:solc@0.8.17",
    "solc5": "npm:solc@0.5.17",
    "solmate": "6.8.0",
    "vite": "5.4.14"
  },
  "engines": {
    "node": ">=22 <24"
